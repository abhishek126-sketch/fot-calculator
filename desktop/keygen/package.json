{
  "name": "fot-key-generator",
  "productName": "FOT Key Generator",
  "version": "2.0.0",
  "description": "PRIVATE monthly subscription key generator for FOT Calculator 2.0 (reads the private key from FOT-Publisher-Keys; do not redistribute)",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "prepare-lib": "node scripts/copy-lib.js",
    "predist": "npm run prepare-lib",
    "dist": "electron-builder --win dir --x64"
  },
  "build": {
    "appId": "com.abhishek126.fotkeygen",
    "productName": "FOT Key Generator",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "package.json",
      "lib/licence.js"
    ],
    "win": {
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "FOT-Key-Generator-Setup-${version}.${ext}",
      "signAndEditExecutable": false,
      "executableName": "FOT Key Generator"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "FOT Key Generator",
      "include": "build/installer.nsh"
    }
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  }
}
